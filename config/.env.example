# Copy to .env in the project root and fill in your own values.
# Never commit the real .env file.

DATAENRICH_DB_PATH=data/enrichment.db

# Domain discovery — two independent search APIs, cross-checked against each
# other before a domain is trusted (single-source name matching alone produces
# too many false positives — see docs/ARCHITECTURE.md once written).
SEARCH_API_KEY_PRIMARY=
SEARCH_API_KEY_SECONDARY=

# Contact enrichment vendor (a domain-based contact-lookup API, e.g. Hunter.io
# or similar).
ENRICHMENT_API_KEY=

PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
